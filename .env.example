# AI Video Studio - environment variables template
#
# Copy this file to ".env" and fill in real values there.
# ".env" is git-ignored (see .gitignore) so your token never gets committed.
# See docs/huggingface.md for how this is loaded.

# Free Hugging Face account token, used by providers/huggingface_provider.py.
# Create an account at https://huggingface.co (free) then generate a token
# (read access is enough) at https://huggingface.co/settings/tokens.
HF_TOKEN=
